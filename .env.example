# Общие
APP_NAME=Quest
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change_me_to_long_random_string

# База данных
POSTGRES_DB=quest
POSTGRES_USER=quest
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg2://quest:change_me@db:5432/quest

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://quest.leonet.site

# Загрузки
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_MIMES=image/jpeg,image/png,image/webp,image/gif

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CREATE_PROFILE=10/hour
RATE_LIMIT_UPLOAD=20/hour
RATE_LIMIT_EDIT=60/hour
RATE_LIMIT_AUTH=20/hour

# Вопросы
QUESTIONS_CONFIG_PATH=/app/config/questions.yaml

# VK ID
# VK_CLIENT_ID — ID приложения из настроек VK ID.
# VK_SERVICE_TOKEN — "Сервисный ключ доступа" из раздела "Ключи доступа".
# Обязателен, если приложение имеет уровень конфиденциальности "Конфиденциальное".
# "Защищённый ключ" (client_secret) в серверном обмене кода VK ID не используется.
VK_CLIENT_ID=
VK_SERVICE_TOKEN=
VK_REDIRECT_URI=https://quest.leonet.site/api/auth/vk/callback
# Токен VK ID выдаёт именно /oauth2/auth (а не /oauth2/token).
VK_AUTH_URL=https://id.vk.com/authorize
VK_TOKEN_URL=https://id.vk.com/oauth2/auth
VK_USERINFO_URL=https://id.vk.com/oauth2/user_info

# Сессии
SESSION_COOKIE_NAME=quest_session
SESSION_TTL_HOURS=168

# Frontend
VITE_API_BASE_URL=/api
VITE_PUBLIC_BASE_URL=https://quest.leonet.site
